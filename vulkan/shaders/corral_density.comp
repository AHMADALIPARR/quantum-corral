#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint nx;
    uint ny;
} pc;

layout(std430, binding = 0) readonly buffer RealField { float re[]; };
layout(std430, binding = 1) readonly buffer ImagField { float im[]; };
layout(std430, binding = 2) writeonly buffer DensityField { float rho[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.nx || y >= pc.ny) return;

    uint idx = y * pc.nx + x;
    float r = re[idx];
    float i = im[idx];
    rho[idx] = r * r + i * i;
}
